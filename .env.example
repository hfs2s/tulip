# Copy to .env and fill in. .env is gitignored and must stay that way.

# ─── Required ─────────────────────────────────────────────────────────────────

# The agent needs exactly one credential. Set EITHER the Anthropic key below, OR
# the provider override further down — not both.
#
# Whichever you use, anyone who achieves code execution in the agent container
# can read it — the threat model assumes they will — so use a **dedicated,
# spend-capped credential**, not the one you use for everything else. Rotating
# it is a one-line change and a restart.
ANTHROPIC_API_KEY=sk-ant-replace-me

# ─── Or: an Anthropic-compatible provider ─────────────────────────────────────
# Claude Code speaks to any endpoint implementing the Messages API. Leave these
# empty to use Anthropic directly; the supervisor strips empty values, because
# an empty base URL is not the same as no base URL.
#
# Two things to get right when pointing elsewhere:
#   · add the host to TULIP_EGRESS_ALLOW below, or the agent cannot reach it
#   · some models think by default and spend the entire token budget on
#     reasoning, returning an empty reply — set MAX_THINKING_TOKENS=0 for those
#
# Example, Z.ai's GLM coding plan:
#   ANTHROPIC_BASE_URL=https://api.z.ai/api/anthropic
#   ANTHROPIC_AUTH_TOKEN=<your key>
#   TULIP_MODEL=glm-5.3-flash
#   MAX_THINKING_TOKENS=0
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
MAX_THINKING_TOKENS=

# ─── Optional ─────────────────────────────────────────────────────────────────

# Model for the agent's sessions. Empty means Claude Code's default.
TULIP_MODEL=

# Claude Code sessions resident at once. Each is a live process; beyond this the
# least recently used is closed, and resumes from disk on its next message.
# Three is comfortable on a Raspberry Pi 5 with 8 GB.
TULIP_MAX_LIVE_SESSIONS=3

# How long a session may sit idle before it is closed. Context is not lost.
TULIP_SESSION_IDLE_MS=1800000

# Hosts the agent may reach, comma-separated. Deny-by-default: empty refuses
# everything, which is a valid and maximally restrictive setting.
#
# Every entry here is a channel out of the jail. Add one only with a reason, and
# prefer an exact hostname to a `*.` wildcard.
#
# The two defaults are the minimum for Claude Code to start:
#   api.anthropic.com    inference
#   platform.claude.com  the entitlement check it makes at startup. Without it
#                        Claude Code exits with "might not be available in your
#                        country", which is its generic message for a failed
#                        network call and is misleading here.
#
# Telemetry, error reporting and the auto-updater are switched off by
# environment variable in the Dockerfile, so nothing else is needed. If you add
# a host, find out why it is wanted first: the proxy log names every refusal.
TULIP_EGRESS_ALLOW=api.anthropic.com,platform.claude.com

# Concurrent tunnels the proxy will hold open.
TULIP_EGRESS_MAX_TUNNELS=32

# ─── Panel exposure ───────────────────────────────────────────────────────────
# Which host interface the control panel is published on. Loopback by default;
# reach it over an SSH tunnel. Set this to a specific private address only when
# something else has to reach it — a Cloudflare tunnel running on another
# machine, for instance — and put an authenticating proxy in front when you do.
# The panel can read every message and hold delivery, and it authenticates with
# a single bearer token.
#
# Never set this to 0.0.0.0.
TULIP_PANEL_BIND=127.0.0.1

# ─── Cloudflare Access (optional) ─────────────────────────────────────────────
# Set both of these when the panel is published behind Cloudflare Access, and
# the panel will accept a person Cloudflare has authenticated as well as the
# bearer token. Adding an operator then becomes a policy change in the Zero
# Trust dashboard — no secret is handed out, and removing one is immediate and
# affects only them.
#
# Both are required. The AUD tag is what binds an assertion to *this*
# application; with only the team domain set, a token minted for any other app
# on the same Cloudflare account would be accepted here. Leaving either blank
# disables Access authentication rather than relaxing it.
#
# Neither is a secret: the tag is an identifier, and every assertion is checked
# against Cloudflare's published signing keys. Find the tag on the application's
# page in Zero Trust → Access → Applications.
TULIP_ACCESS_TEAM_DOMAIN=
TULIP_ACCESS_AUD=

# ─── GIFs ─────────────────────────────────────────────────────────────────────
# A free key from developers.giphy.com. Read by the BRIDGE, not the agent: the
# agent names a search phrase and the trusted side fetches it, so the key never
# enters the container an attacker might own and the egress allowlist is
# untouched. Leave empty and GIF sends fail gracefully.
GIPHY_API_KEY=
# g | pg | pg-13 | r. Enforced in the bridge, where the agent cannot change it.
GIPHY_RATING=pg

# ─── Pictures and voice ───────────────────────────────────────────────────────
# MiniMax, read by the BRIDGE. The agent asks for a picture or a spoken line and
# the trusted side produces it, so this billed key never enters the container an
# attacker might own.
#
# These are paid, per-message capabilities on a number the public can reach —
# a cost-denial-of-service if left unbounded. They spend the same per-turn and
# per-chat allowance as any other send. Leave empty and both fail gracefully;
# voice falls back to sending the same words as text.
MINIMAX_API_KEY=
# Some accounts need a group id for the speech endpoint. Ours does not.
MINIMAX_GROUP_ID=
#
# Every value below is optional: blank means the built-in default, and blank is
# read as *absent* rather than as an empty setting. That distinction is not
# pedantic — `docker-compose.yml` passes these through as `${VAR:-}`, which sets
# them to the empty string, and an earlier version fell back only on `undefined`.
# The result was a relative request URL and no pictures or voice notes at all,
# reported as a provider failure. See `env()` in bridge/src/minimax.ts.
#
# The voice. Must exist on this account and for the chosen model — a `moss_audio_`
# id is a custom voice and belongs to whoever cloned it, so it is not portable to
# another MiniMax account. Verify a new one against the API before shipping it:
# an unknown voice id fails the whole request, and voice notes fall back to text.
MINIMAX_VOICE_ID=moss_audio_737a299c-734a-11f0-918f-4e0486034804
# Only the 2.5 and 2.8 models accept `language_boost` or inline sound tags;
# speech-02 and speech-01 reject the first outright, so move these two together.
MINIMAX_VOICE_MODEL=speech-2.8-turbo
MINIMAX_LANGUAGE_BOOST=English
# happy | sad | angry | fearful | disgusted | surprised | neutral, or `none` for
# a flat read. An unrecognised value is dropped rather than sent: the provider
# refuses an unknown emotion with a 400 and takes the whole voice note with it.
MINIMAX_VOICE_EMOTION=none
# The picture model.
MINIMAX_IMAGE_MODEL=image-01

# ─── Transcription ────────────────────────────────────────────────────────────
# Inbound voice notes, turned into words the agent can read. It is a Claude Code
# session: it can open an image and look at it, and it cannot listen to
# anything, so without this a voice note is a file it can do nothing with.
#
# Read by the BRIDGE, never the agent. This is the one deliberate exception to
# "MiniMax is the only approved audio provider": MiniMax synthesises speech and
# does not recognise it — every transcription endpoint on that account returns
# 404 — so there is no MiniMax option to prefer. Used for exactly one thing.
#
# Leave empty and voice notes still arrive; the agent is told it could not read
# them and says so, rather than answering as though nothing was sent.
OPENAI_API_KEY=
# whisper-1 by default. gpt-4o-mini-transcribe also works and costs less.
OPENAI_TRANSCRIBE_MODEL=
OPENAI_BASE_URL=

# ─── Web search ───────────────────────────────────────────────────────────────
# Keys from exa.ai, read by the BRIDGE. The agent has no network: it asks for a
# search or a page and the bridge performs it, so the key stays on the trusted
# side and the egress allowlist gains no host.
#
# Read docs/THREAT-MODEL.md §T6 before enabling this. It is the one feature that
# meaningfully raises the risk profile — a web page can be prepared in advance
# by somebody who is not in the conversation, and there is no sender to block.
# Leave these empty and search fails gracefully.
#
# The extras are tried in turn when one is rate-limited.
EXA_API_KEY=
EXA_BACKUP_API_KEY=
EXA_BACKUP_API_KEY2=

# Copy to .env and fill in. .env is gitignored and must stay that way.

# ─── Required ─────────────────────────────────────────────────────────────────

# The agent needs exactly one credential. Set EITHER the Anthropic key below, OR
# the provider override further down — not both.
#
# Whichever you use, anyone who achieves code execution in the agent container
# can read it — the threat model assumes they will — so use a **dedicated,
# spend-capped credential**, not the one you use for everything else. Rotating
# it is a one-line change and a restart.
ANTHROPIC_API_KEY=sk-ant-replace-me

# ─── Or: an Anthropic-compatible provider ─────────────────────────────────────
# Claude Code speaks to any endpoint implementing the Messages API. Leave these
# empty to use Anthropic directly; the supervisor strips empty values, because
# an empty base URL is not the same as no base URL.
#
# Two things to get right when pointing elsewhere:
#   · add the host to TULIP_EGRESS_ALLOW below, or the agent cannot reach it
#   · some models think by default and spend the entire token budget on
#     reasoning, returning an empty reply — set MAX_THINKING_TOKENS=0 for those
#
# Example, Z.ai's GLM coding plan:
#   ANTHROPIC_BASE_URL=https://api.z.ai/api/anthropic
#   ANTHROPIC_AUTH_TOKEN=<your key>
#   TULIP_MODEL=glm-5.3-flash
#   MAX_THINKING_TOKENS=0
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
MAX_THINKING_TOKENS=

# ─── Optional ─────────────────────────────────────────────────────────────────

# Model for the agent's sessions. Empty means Claude Code's default.
TULIP_MODEL=

# Claude Code sessions resident at once. Each is a live process; beyond this the
# least recently used is closed, and resumes from disk on its next message.
# Three is comfortable on a Raspberry Pi 5 with 8 GB.
TULIP_MAX_LIVE_SESSIONS=3

# How long a session may sit idle before it is closed. Context is not lost.
TULIP_SESSION_IDLE_MS=1800000

# Hosts the agent may reach, comma-separated. Deny-by-default: empty refuses
# everything, which is a valid and maximally restrictive setting.
#
# Every entry here is a channel out of the jail. Add one only with a reason, and
# prefer an exact hostname to a `*.` wildcard.
#
# The two defaults are the minimum for Claude Code to start:
#   api.anthropic.com    inference
#   platform.claude.com  the entitlement check it makes at startup. Without it
#                        Claude Code exits with "might not be available in your
#                        country", which is its generic message for a failed
#                        network call and is misleading here.
#
# Telemetry, error reporting and the auto-updater are switched off by
# environment variable in the Dockerfile, so nothing else is needed. If you add
# a host, find out why it is wanted first: the proxy log names every refusal.
TULIP_EGRESS_ALLOW=api.anthropic.com,platform.claude.com

# Concurrent tunnels the proxy will hold open.
TULIP_EGRESS_MAX_TUNNELS=32

# ─── GIFs ─────────────────────────────────────────────────────────────────────
# A free key from developers.giphy.com. Read by the BRIDGE, not the agent: the
# agent names a search phrase and the trusted side fetches it, so the key never
# enters the container an attacker might own and the egress allowlist is
# untouched. Leave empty and GIF sends fail gracefully.
GIPHY_API_KEY=
# g | pg | pg-13 | r. Enforced in the bridge, where the agent cannot change it.
GIPHY_RATING=pg

# ─── Web search ───────────────────────────────────────────────────────────────
# Keys from exa.ai, read by the BRIDGE. The agent has no network: it asks for a
# search or a page and the bridge performs it, so the key stays on the trusted
# side and the egress allowlist gains no host.
#
# Read docs/THREAT-MODEL.md §T6 before enabling this. It is the one feature that
# meaningfully raises the risk profile — a web page can be prepared in advance
# by somebody who is not in the conversation, and there is no sender to block.
# Leave these empty and search fails gracefully.
#
# The extras are tried in turn when one is rate-limited.
EXA_API_KEY=
EXA_BACKUP_API_KEY=
EXA_BACKUP_API_KEY2=
